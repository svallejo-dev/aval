{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/svallejo-dev/aval/schema/change.v1.json",
  "title": "aval change manifest (openspec/changes/<id>/aval.yaml), version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tier"],
  "properties": {
    "version": { "const": 1 },
    "tier": {
      "description": "Risk tier: 0 costs no artifacts, 3 needs human approval.",
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "owner": { "type": "string", "minLength": 1 }
  }
}
