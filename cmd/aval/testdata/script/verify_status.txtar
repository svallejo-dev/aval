# The exit code and the status the agent hooks read answer different questions.
#
# aval reads no review locally, so at tier 3 the verdict always carries
# approval_missing (ADR-0005 §5). The exit code is §6 unchanged: a block in
# enforce mode is 1, for both commands, even when that approval is the only thing
# blocking — the gate grants no agent exemption, and a human running verify before
# pushing sees the failure.
#
# The status is where the exemption lives, and only for that one code: it says
# passed and records which code it passed in spite of, so a Stop hook lets the
# agent finish instead of holding it for an approval it cannot obtain. Any other
# blocking reason is work, and then the status says not passed and claims nothing.

[!exec:git] skip 'needs git'
[!exec:go] skip 'needs the go command'

env GIT_CONFIG_NOSYSTEM=1
env GIT_AUTHOR_NAME=aval
env GIT_AUTHOR_EMAIL=aval@example.com
env GIT_COMMITTER_NAME=aval
env GIT_COMMITTER_EMAIL=aval@example.com

cd repo
exec git init -q -b main
exec git add -A
exec git commit -q -m 'chore: adopt aval at tier 3'

# A feat commit, so tierDefault makes the pull request tier 3. Every test passes,
# so nothing blocks but the approval nobody could give here.
exec git checkout -q -b work
cp $WORK/grown.go refund/refund.go
exec git add -A
exec git commit -q -m 'feat: answer whether a key was refunded twice'

! exec aval verify --plain
stdout '^✗ aval: block · tier 3 · enforce$'
stdout '^- approval_missing'
! stdout '^- after_not_passing'
stderr '^aval: verify failed: block · tier 3 · 1 reason · approval_missing$'

# The status passes, and names the code it passed in spite of. A hook that found
# any other code there would refuse the status rather than trust a claim it
# cannot check.
grep '"schemaVersion": 2' .aval/cache/verify-status.json
grep '"passed": true' .aval/cache/verify-status.json
grep '"approval_missing"' .aval/cache/verify-status.json

# The gate has no exemption at all: same range, same verdict, exit 1.
! exec aval gate --plain
stdout '^✗ aval: block · tier 3 · enforce$'
stdout '^- approval_missing'
stderr '^aval: gate failed: block · tier 3 · 1 reason · approval_missing$'

# Now break the bound test. after_not_passing is the agent's to fix, so the
# status says not passed and claims no exemption.
cp $WORK/broken.go refund/refund.go
exec git add -A
exec git commit -q -m 'feat: break the refund rule'

! exec aval verify --plain
stdout '^✗ aval: block · tier 3 · enforce$'
stdout '^- after_not_passing — a bound test does not pass at head$'
stdout '^- approval_missing'
stderr '^aval: verify failed: block · tier 3 · 2 reasons · ORD-F01 after_not_passing$'
grep '"passed": false' .aval/cache/verify-status.json
! grep '"exempt"' .aval/cache/verify-status.json

# The same range in json mode: the reasons make the envelope's ok false (ADR-0003).
! exec aval verify --json
stdout '"ok": false'
stdout '"code": "failed"'
stdout '"result": "block"'
! stderr .

-- grown.go --
package refund

// Once reports whether a refund for a key that was seen may go through.
func Once(seen bool) bool { return !seen }

// Twice reports whether a key was refunded twice.
func Twice(count int) bool { return count > 1 }
-- broken.go --
package refund

// Once reports whether a refund for a key that was seen may go through.
func Once(seen bool) bool { return seen }

// Twice reports whether a key was refunded twice.
func Twice(count int) bool { return count > 1 }
-- repo/go.mod --
module example.com/shop

go 1.22
-- repo/aval.yaml --
version: 1
context: ORD
mode: enforce
tierDefault: 3
openspec:
  version: 1.13.1
paths:
  dx:
    - docs/**
  feat:
    - refund/**
-- repo/openspec/specs/refunds/spec.md --
# refunds Specification

## Requirements

### Requirement: ORD-F01 Refund is idempotent
The system SHALL process a refund at most once per key.

#### Scenario: Duplicate key
- **WHEN** a refund arrives with a processed key
- **THEN** the first result is returned
-- repo/refund/refund.go --
package refund

// Once reports whether a refund for a key that was seen may go through.
func Once(seen bool) bool { return !seen }
-- repo/refund/refund_test.go --
package refund

import "testing"

func TestRefund(t *testing.T) {
	t.Run("ORD-F01 refunds once", func(t *testing.T) {
		if !Once(false) {
			t.Fatal("the first refund must go through")
		}
	})
}
